<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/25.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.app.controllers.ViewProductsController" stylesheets="@welcome-tray.css">

    <Text styleClass="title-text" text="All Products (Admin View)" />

    <TableView fx:id="productsTable" prefHeight="450.0" styleClass="user-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80" text="ID" />
            <TableColumn fx:id="categoryColumn" prefWidth="100" text="Category" />
            <TableColumn fx:id="typeColumn" prefWidth="120" text="Type/Compatibility" />
            <TableColumn fx:id="nameColumn" prefWidth="200" text="Name" />
            <TableColumn fx:id="priceColumn" prefWidth="100" text="Price" />
            <TableColumn fx:id="stockColumn" prefWidth="100" text="Stock" />
            <TableColumn fx:id="costColumn" prefWidth="100" text="Purchase Cost" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#handleBack" prefWidth="150" text="&lt; Back to Menu" styleClass="secondary-button" />
    </HBox>

</VBox>
