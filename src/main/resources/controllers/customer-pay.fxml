<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.app.controllers.CustomerPayController" stylesheets="@welcome-tray.css">

    <Text styleClass="title-text" text="Pay" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <!-- Basket contents on the left -->
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-weight: bold;" text="Your Basket" />
            <TableView fx:id="basketTable" prefHeight="400.0" styleClass="user-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" prefWidth="220" text="Product" />
                    <TableColumn fx:id="amountColumn" prefWidth="80" text="Amount" />
                    <TableColumn fx:id="lineTotalColumn" prefWidth="110" text="Total" />
                    <TableColumn fx:id="removeColumn" prefWidth="100" text="" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Button fx:id="clearBasketButton" onAction="#handleClearBasket" text="Clear Basket" styleClass="secondary-button" />
        </VBox>

        <!-- Total and payment method on the right -->
        <VBox spacing="14.0" prefWidth="260" style="-fx-padding: 10;">
            <Label style="-fx-font-weight: bold;" text="Order Total" />
            <Label fx:id="totalLabel" style="-fx-font-size: 26px; -fx-font-weight: bold;" text="0.00" />

            <Label style="-fx-font-weight: bold;" text="How would you like to pay?" />
            <VBox spacing="8.0">
                <RadioButton fx:id="payPalRadio" text="PayPal" selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="paymentMethodGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="creditCardRadio" text="Credit Card" toggleGroup="$paymentMethodGroup" />
            </VBox>

            <Button fx:id="paymentButton" onAction="#handlePayment" prefWidth="200" text="Payment" styleClass="primary-button" />
            <Label fx:id="statusLabel" styleClass="hint-text" wrapText="true" />
        </VBox>

    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#handleBack" prefWidth="150" text="&lt; Back to Menu" styleClass="secondary-button" />
    </HBox>

</VBox>
