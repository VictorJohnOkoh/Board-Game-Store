<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.app.controllers.AdminMenuController"
      prefHeight="500.0" prefWidth="700.0" style="-fx-padding: 20;" stylesheets="@theme-walnut.css">

    <Label fx:id="welcomeLabel" styleClass="title-text" />


    <VBox alignment="CENTER" spacing="15.0">
        <Button onAction="#handleViewProducts" text="View All Products" prefWidth="250" styleClass="primary-button" />
        <Button onAction="#handleAddProduct" text="Add New Product" prefWidth="250" styleClass="primary-button" />
        <Button onAction="#handleRollback" text="Rollback Database" prefWidth="250" styleClass="secondary-button" />
        <Button onAction="#handleExit" text="Logout" prefWidth="250" styleClass="secondary-button" />
    </VBox>

</VBox>
