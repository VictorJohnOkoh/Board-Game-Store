<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.collections.FXCollections?>
<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="750.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.app.contollers.AddProductController" stylesheets="@welcome-tray.css">

    <Text styleClass="title-text" text="Add New Product" />

    <TabPane VBox.vgrow="ALWAYS">
        <Tab closable="false" text="Board Game">
            <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 15;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Board Game Details" />
                <GridPane hgap="10.0" vgap="10.0">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                    <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Product ID:" />
                    <TextField fx:id="bgIdField" promptText="4-digit numeric ID" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Genre/Type:" />
                    <TextField fx:id="bgTypeField" promptText="e.g., strategy, card, party" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Name:" />
                    <TextField fx:id="bgNameField" promptText="Game name" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="3" text="Price (£):" />
                    <TextField fx:id="bgPriceField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="4" text="Stock Quantity:" />
                    <TextField fx:id="bgStockField" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="5" text="Purchase Cost (£):" />
                    <TextField fx:id="bgCostField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="6" text="Number of Players:" />
                    <TextField fx:id="bgPlayersField" promptText="min-max or exact number" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="200" />

                    <Button onAction="#handleAddBoardGame" prefWidth="200" text="Add Board Game" GridPane.columnIndex="1" GridPane.rowIndex="7" styleClass="primary-button" />
                </GridPane>
            </VBox>
        </Tab>
        <Tab closable="false" text="Accessory">
            <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 15;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Accessory Details" />
                <GridPane hgap="10.0" vgap="10.0">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                    <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Product ID:" />
                    <TextField fx:id="accIdField" promptText="4-digit numeric ID" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Type:" />
                    <ChoiceBox fx:id="accTypeField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <items>
                            <FXCollections xmlns:fx="http://javafx.com/fxml/1">
                                <String fx:value="miniature"></String>
                                <String fx:value="dice"></String>
                                <String fx:value="accessory kit"></String>
                            </FXCollections>
                        </items>
                    </ChoiceBox>

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Name:" />
                    <TextField fx:id="accNameField" promptText="Accessory name" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="3" text="Price (£):" />
                    <TextField fx:id="accPriceField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="4" text="Stock Quantity:" />
                    <TextField fx:id="accStockField" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="5" text="Purchase Cost (£):" />
                    <TextField fx:id="accCostField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="200" />

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="6" text="Compatibility:" />
                    <TextField fx:id="accCompatField" promptText="e.g., Kingdoms of Valor" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="200" />

                    <Button onAction="#handleAddAccessory" prefWidth="200" text="Add Accessory" GridPane.columnIndex="1" GridPane.rowIndex="7" styleClass="primary-button" />
                </GridPane>
            </VBox>
        </Tab>
    </TabPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label fx:id="statusLabel" text="" />
        <Button onAction="#handleBack" prefWidth="150" text="&lt; Back to Menu" styleClass="secondary-button" />
    </HBox>

</VBox>
