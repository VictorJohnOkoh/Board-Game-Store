<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="12.0" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.app.controllers.CustomerProductsController" stylesheets="@welcome-tray.css">

    <Text styleClass="title-text" text="Products" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Search:" />
        <TextField fx:id="searchField" prefWidth="260" promptText="Product ID or compatibility (not both)" />
        <Button fx:id="searchButton" onAction="#handleSearch" text="Search" styleClass="primary-button" />
        <Button onAction="#handleClearSearch" text="Clear" styleClass="secondary-button" />
        <Label fx:id="statusLabel" styleClass="hint-text" />
    </HBox>

    <TableView fx:id="productsTable" prefHeight="420.0" styleClass="user-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
            <TableColumn fx:id="categoryColumn" prefWidth="90" text="Category" />
            <TableColumn fx:id="typeColumn" prefWidth="110" text="Type" />
            <TableColumn fx:id="nameColumn" prefWidth="190" text="Name" />
            <TableColumn fx:id="detailColumn" prefWidth="140" text="Players / Compatibility" />
            <TableColumn fx:id="priceColumn" prefWidth="80" text="Price" />
            <TableColumn fx:id="stockColumn" prefWidth="70" text="Stock" />
            <TableColumn fx:id="addColumn" prefWidth="90" text="" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label fx:id="basketLabel" styleClass="hint-text" />
        <Button onAction="#handleBack" prefWidth="150" text="&lt; Back to Menu" styleClass="secondary-button" />
    </HBox>

</VBox>
