<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="560.0" prefWidth="700.0" spacing="14.0" styleClass="root" stylesheets="@theme-walnut.css" xmlns="http://javafx.com/javafx/25.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.app.controllers.WelcomeController">

    <Text styleClass="kicker-text" text="LOGIN" />
    <Text styleClass="title-text" text="Welcome" />
    <Separator styleClass="rule-line" />
    <Text styleClass="step-label" text="Choose an account to login" />

    <!-- Static sample tiles for preview. Replace/repopulate at runtime via fx:id="userGrid". -->
    <FlowPane fx:id="userGrid" alignment="CENTER" hgap="22.0" styleClass="user-grid" vgap="26.0" VBox.vgrow="ALWAYS">

        <VBox alignment="CENTER" spacing="6.0" styleClass="user-component">
            <StackPane>
                <Circle radius="32.0" style="-fx-fill: #C1502E;" styleClass="icon-token" />
                <Label styleClass="initials-label" text="AR" />
            </StackPane>
            <Region styleClass="leader-line" />
            <Label styleClass="name-label" text="Alex Rivera" />
            <Label styleClass="stamp-badge role-admin" text="ADMIN" />
        </VBox>

        <VBox alignment="CENTER" spacing="6.0" styleClass="user-component">
            <StackPane>
                <Circle radius="32.0" style="-fx-fill: #3E6A8F;" styleClass="icon-token" />
                <Label styleClass="initials-label" text="JB" />
            </StackPane>
            <Region styleClass="leader-line" />
            <Label styleClass="name-label" text="Jordan Blake" />
            <Label styleClass="stamp-badge role-customer" text="CUSTOMER" />
        </VBox>

        <VBox alignment="CENTER" spacing="6.0" styleClass="user-component">
            <StackPane>
                <Circle radius="32.0" style="-fx-fill: #D9A441;" styleClass="icon-token" />
                <Label styleClass="initials-label" text="SW" />
            </StackPane>
            <Region styleClass="leader-line" />
            <Label styleClass="name-label" text="Sam Whitfield" />
            <Label styleClass="stamp-badge role-customer" text="CUSTOMER" />
        </VBox>

        <VBox alignment="CENTER" spacing="6.0" styleClass="user-component">
            <StackPane>
                <Circle radius="32.0" style="-fx-fill: #7A5A9E;" styleClass="icon-token" />
                <Label styleClass="initials-label" text="PN" />
            </StackPane>
            <Region styleClass="leader-line" />
            <Label styleClass="name-label" text="Priya Natarajan" />
            <Label styleClass="stamp-badge role-admin" text="ADMIN" />
        </VBox>

        <VBox alignment="CENTER" spacing="6.0" styleClass="user-component">
            <StackPane>
                <Circle radius="32.0" style="-fx-fill: #4B7F52;" styleClass="icon-token" />
                <Label styleClass="initials-label" text="DM" />
            </StackPane>
            <Region styleClass="leader-line" />
            <Label styleClass="name-label" text="Devon Marsh" />
            <Label styleClass="stamp-badge role-customer" text="CUSTOMER" />
        </VBox>

        <VBox alignment="CENTER" spacing="6.0" styleClass="user-component">
            <StackPane>
                <Circle radius="32.0" style="-fx-fill: #2F6F63;" styleClass="icon-token" />
                <Label styleClass="initials-label" text="CN" />
            </StackPane>
            <Region styleClass="leader-line" />
            <Label styleClass="name-label" text="Casey Nguyen" />
            <Label styleClass="stamp-badge role-customer" text="CUSTOMER" />
        </VBox>

    </FlowPane>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="footer-bar">
        <Label styleClass="hint-text" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleExit" prefWidth="140" styleClass="secondary-button" text="Exit" />
        <Button onAction="#handleLogin" prefWidth="140" styleClass="primary-button" text="Login" />
    </HBox>

</VBox>
