<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="700.0" spacing="18.0" style="-fx-padding: 25;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.app.controllers.CustomerPaymentController" stylesheets="@theme-walnut.css">

    <Text fx:id="titleText" styleClass="title-text" text="Payment" />

    <Label fx:id="amountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="" />

    <!-- PayPal fields -->
    <VBox fx:id="payPalFields" spacing="6.0" maxWidth="380">
        <Label text="PayPal email:" />
        <TextField fx:id="emailField" promptText="you@example.com" />
        <Label fx:id="emailError" style="-fx-text-fill: #b3261e;" wrapText="true" />
    </VBox>

    <!-- Credit card fields -->
    <VBox fx:id="creditCardFields" spacing="10.0" maxWidth="380">
        <GridPane hgap="10.0" vgap="6.0">
            <padding><Insets bottom="5" left="0" right="0" top="0"/></padding>
            <Label text="Card number:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cardNumberField" promptText="6 digits" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label fx:id="cardNumberError" style="-fx-text-fill: #b3261e;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Security code:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="securityCodeField" promptText="3 digits" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label fx:id="securityCodeError" style="-fx-text-fill: #b3261e;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        </GridPane>
    </VBox>

    <HBox alignment="CENTER" spacing="12.0">
        <Button onAction="#handleCancel" prefWidth="150" text="Cancel" styleClass="secondary-button" />
        <Button fx:id="payButton" onAction="#handlePay" prefWidth="180" text="Pay" styleClass="primary-button" />
    </HBox>

</VBox>
